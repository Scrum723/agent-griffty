{
  "name": "@griffty/electron",
  "version": "1.0.0",
  "description": "Griffty Desktop — Electron wrapper for the Griffty operator console",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.docweather.griffty",
    "productName": "Griffty",
    "mac": { "target": "dmg", "icon": "assets/icon.icns" },
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "files": ["dist/**", "assets/**"],
    "extraResources": [{ "from": "../dashboard/dist", "to": "dashboard" }]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
