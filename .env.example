# SpaceXAI (xAI) — server-side only. Never put this in the dashboard bundle.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Local operator
OPERATOR_UID=operator_1
OPERATOR_TOKEN=dev-operator-token
GRIFFTY_STATE_DIR=.griffty

# Firebase / Google Cloud (project griffty). ADC via `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=griffty
GOOGLE_CLOUD_PROJECT=griffty
GRIFFTY_STORE=firestore

# Connector flags — all off until an official enrolled session exists
CONNECTOR_PROLIFIC=false
CONNECTOR_RESPONDENT=false
CONNECTOR_USER_INTERVIEWS=false
CONNECTOR_FREE_CASH=false
CONNECTOR_HONEYGAIN=false
CONNECTOR_WEATHERXM=false
CONNECTOR_GALXE=false
CONNECTOR_ADS_GOOGLE=false
CONNECTOR_ADS_META=false
CONNECTOR_ADS_TIKTOK=false
CONNECTOR_ADS_X=false
CONNECTOR_SHOPIFY=false

# Google Ads (read-only). Never commit tokens.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Optional: CoinMarketCap for quotes. Never commit the key.
CMC_PRO_API_KEY=
