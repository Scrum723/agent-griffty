# SpaceXAI (xAI) — server-side only. Never put this in the dashboard bundle.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Local operator
OPERATOR_UID=operator_1
OPERATOR_TOKEN=dev-operator-token
OPERATOR_PHONE=
OPERATOR_EMAIL=
GIVESENDGO_URL=https://www.givesendgo.com/graduate-r-d-and-creator-bridging-the-ga
GOFUNDME_URL=https://www.gofundme.com/f/help-charles-bridge-the-gap-j8uh2
GRIFFTY_STATE_DIR=.griffty

# Firebase / Google Cloud (project griffty). ADC via `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=griffty
GOOGLE_CLOUD_PROJECT=griffty
GRIFFTY_STORE=firestore

# Connector flags — all off until an official enrolled session exists
CONNECTOR_PROLIFIC=false
CONNECTOR_RESPONDENT=false
CONNECTOR_USER_INTERVIEWS=false
CONNECTOR_FREE_CASH=false
CONNECTOR_HONEYGAIN=false
CONNECTOR_WEATHERXM=false
CONNECTOR_GALXE=false
CONNECTOR_ADS_GOOGLE=false
CONNECTOR_ADS_META=false
CONNECTOR_ADS_TIKTOK=false
CONNECTOR_ADS_X=false
CONNECTOR_SHOPIFY=false

# Google Ads (read-only). Never commit tokens.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Optional: CoinMarketCap for quotes. Never commit the key.
CMC_PRO_API_KEY=
CONNECTOR_USER_TESTING=false
CONNECTOR_DSCOUT=false
CONNECTOR_GRASSIO=false
CONNECTOR_NODEPAY=false
CONNECTOR_AMAZON_ASSOCIATES=false
CONNECTOR_YOUTUBE_MONETIZE=false
CONNECTOR_TIKTOK_LIVE=false
CONNECTOR_SPOTIFY_PODCAST=false
CONNECTOR_DISTROKID=false
CONNECTOR_SOCIAL_X=false
CONNECTOR_SOCIAL_TIKTOK=false
CONNECTOR_SOCIAL_META=false
CONNECTOR_SOCIAL_YOUTUBE=false

SOCIAL_X_ACCESS_TOKEN=
SOCIAL_TIKTOK_ACCESS_TOKEN=
SOCIAL_META_ACCESS_TOKEN=
SOCIAL_YOUTUBE_ACCESS_TOKEN=
DISTROKID_SESSION_TOKEN=
OPERATOR_EMAIL=
SENDGRID_API_KEY=
